# Credenciais FTP — 50webs (deploy manual: ./scripts/deploy.sh 50webs)
# Copie este arquivo para .env.ftp e preencha com seus dados
# NUNCA commite o .env.ftp (está no .gitignore)

FTP_HOST='sssr.50webs.org'
FTP_USERNAME='seu_usuario'
FTP_PASSWORD='sua_senha'
FTP_PATH='seu_dominio.50webs.com'

# Credenciais FTP — InfinityFree (deploy manual: ./scripts/deploy.sh infinityfree)
INFINITY_FREE_HOST=ftp.infinityfree.com
INFINITY_FREE_USER='seu_usuario'
INFINITY_FREE_PASSWORD='sua_senha'
INFINITY_FREE_PATH="htdocs"
